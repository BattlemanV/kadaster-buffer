// Сгенерировано CMake из VERSION (см. CMakeLists.txt) — версия и иконка
// exe, видна в Проводнике (правая кнопка на kadbuffer.exe → Свойства →
// Подробно). Не редактировать вручную — правьте файл VERSION в корне.
#include <winver.h>

IDI_ICON1 ICON "@APP_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
    PRODUCTVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS 0x40004L
    FILETYPE 0x1L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "KadBuffer"
            VALUE "FileDescription", "KadBuffer - neighbor cadastral parcels within a buffer zone"
            VALUE "FileVersion", "@APP_VERSION_MAJOR@.@APP_VERSION_MINOR@.@APP_VERSION_PATCH@.0"
            VALUE "InternalName", "kadbuffer"
            VALUE "OriginalFilename", "kadbuffer.exe"
            VALUE "ProductName", "KadBuffer"
            VALUE "ProductVersion", "@APP_VERSION_MAJOR@.@APP_VERSION_MINOR@.@APP_VERSION_PATCH@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
